# Template for .env.local. Copy it, fill in real values, and never commit .env.local.

# PostgreSQL connection used by Prisma (database: meeting_app)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/meeting_app?schema=public"

# Langflow Desktop, which runs every AI step. 7860 is Langflow's default port; use the URL your Langflow shows.
LANGFLOW_BASE_URL="http://localhost:7860"
LANGFLOW_API_KEY="your-langflow-api-key"
LANGFLOW_TRANSCRIBE_FLOW_ID="your-transcribe-flow-id"
LANGFLOW_REPORT_FLOW_ID="your-report-flow-id"
LANGFLOW_QA_FLOW_ID="your-qa-flow-id"
# Component IDs the app sends tweaks to (see langflow/FLOWS.md, step 5)
LANGFLOW_TRANSCRIBE_COMPONENT_ID="CustomComponent-xxxxx"
LANGFLOW_QA_PROMPT_COMPONENT_ID="Prompt Template-xxxxx"

# Max audio upload size in MB (Groq Whisper's free tier accepts files up to 25 MB)
MAX_UPLOAD_MB=25
